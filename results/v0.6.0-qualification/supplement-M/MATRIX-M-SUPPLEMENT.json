  "order_seed": 60601,
  "warmup_pairs": 2,
  "pairs": 12,
  "seed": 7
 },
 "rules": {
  "interval": "paired log ratios ln(C/B); n=12 -> one-based order statistics r(3), r(10); n=24 -> r(7), r(18) (analyze_bc_qualification.summarize_metric, unchanged)",
  "tolerances": {
   "primary": 0.1,
   "query_tail": 0.25
  },
  "classification": "PASS if upper <= ln(1+t); REGRESSION if lower > ln(1+t); else INCONCLUSIVE. For higher-is-better metrics the ratio is B/C. IMPROVED is reported (never claimed otherwise) only when the upper bound is below 0.",
  "M_reg": "12 analyzed pairs after 2 warmup pairs, a fresh server process per observation, arm order balanced; throughput tolerance primary 10% (ratio B/C), client p99 tolerance query_tail 25%",
  "validity": "a configuration record is VALID only if errors == 0, item_errors is empty, noop_mutations == 0 and, with background activity, background.failures == 0 and background.completed > 0. 503 refusals are allowed and reported (admission limit 32 pending jobs). For M_reg every analyzed observation must also have only status 200 (unchanged analyzer). An invalid record is reported as invalid, never rerun or dropped; an M_reg cell with any invalid analyzed observation gets no verdict (INVALID).",
  "interpretation": "Supplementary verdicts are reported beside the frozen ones. They never replace or re-classify a frozen verdict and grant no waiver; their use is the maintainer's decision.",
  "no_extension": "no extension and no rerun, except one rerun of a child for a documented infrastructure failure unrelated to the measured code",
  "no_waiver_inheritance": "No v0.4.0 or v0.5.0 maintainer waiver applies. A repeated failure is a v0.6.0 failure until the maintainer decides otherwise for v0.6.0 explicitly."
 },
 "host_conditions": {
  "power": "AC (pmset -g batt reports 'AC Power'); checked before every cell; a cell on battery invalidates the run",
  "thermal": "pmset -g therm recorded before every cell; any recorded thermal or performance warning invalidates the cell",
  "concurrency": "no cargo/rustc process and no other campaign; checked before each experiment",
  "awake": "caffeinate -dimsu"
 },
 "invalidation": {
  "code_change": "any change to executed code of knotrel after freezing invalidates every experiment that ran that code; documentation-only commits do not (executed code identity is checked by comparing __TEXT,__text of release builds)",
  "tooling_change": "any change to a probe, collector or analysis after freezing invalidates the affected experiment",
  "failed_child": "a failing child stops the experiment; one rerun only for an infrastructure failure unrelated to the measured code, recorded with its cause",
  "invalid_runs": "kept and reported; never deleted or overwritten (collectors refuse to overwrite)"
 },
 "budget": {
