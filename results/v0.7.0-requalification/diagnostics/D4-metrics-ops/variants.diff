 /// The returned guard records lock wait and execution only after it has
 /// released the lock, on normal drop, early return or unwinding alike, so
 /// histogram synchronization stays outside the critical section.
+/// D4 diagnostic variant (not a product API): 0 released, 1 no lock timing, 2 batch-aggregated
+/// operation counts. Read once from `KNOTREL_D4_VARIANT`.
+pub(crate) fn d4_variant() -> u8 {
+    static VARIANT: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *VARIANT.get_or_init(|| match std::env::var("KNOTREL_D4_VARIANT").as_deref() {
+        Ok("nolocktiming") => 1,
+        Ok("batchcount") => 2,
+        _ => 0,
+    })
+}
+
+/// D4 diagnostic: per-batch operation counts, flushed once (variant 2).
+pub(crate) struct D4Counts(pub(crate) [[u64; OperationOutcome::COUNT]; GraphOp::ALL.len()]);
+
+impl D4Counts {
+    pub(crate) fn new() -> Self {
+        Self([[0; OperationOutcome::COUNT]; GraphOp::ALL.len()])
+    }
+    pub(crate) fn add(&mut self, op: GraphOp, outcome: &Outcome) {
+        self.0[op as usize][outcome_index(outcome)] += 1;
+    }
+}
+
+impl ServiceTelemetry {
+    /// D4 diagnostic: flushes per-batch counts with one increment per non-zero cell.
+    pub(crate) fn count_operations_d4(&self, counts: &D4Counts) {
+        for (op, row) in counts.0.iter().enumerate() {
+            if let Some(counters) = &self.operations[op] {
+                for (outcome, &n) in row.iter().enumerate() {
+                    if n > 0 {
+                        counters[outcome].inc_by(n);
+                    }
+                }
+            }
+        }
+    }
+}
