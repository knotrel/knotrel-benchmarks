@@ -53,6 +53,29 @@
 //! use the corresponding release tag when consulting a published version.
 
 mod api;
+/// D3 diagnostic phase counters (not a product API): nanoseconds and counts, summed over
+/// every request since the last [`d3::reset`].
+pub mod d3 {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    /// Counter names, in index order.
+    pub const NAMES: [&str; 10] = ["requests", "handler_ns", "exec_await_ns", "queue_hop_ns",
+        "lock_wait_ns", "work_ns", "apply_ns", "post_work_ns", "serialize_ns", "operations"];
+    static COUNTERS: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+    /// Zeroes every counter.
+    pub fn reset() {
+        for c in &COUNTERS { c.store(0, Ordering::Relaxed); }
+    }
+    /// Current values, in [`NAMES`] order.
+    pub fn snapshot() -> [u64; 10] {
+        std::array::from_fn(|i| COUNTERS[i].load(Ordering::Relaxed))
+    }
+    pub(crate) fn add(index: usize, value: u64) {
+        COUNTERS[index].fetch_add(value, Ordering::Relaxed);
+    }
+    pub(crate) fn since(index: usize, start: std::time::Instant) {
+        add(index, start.elapsed().as_nanos() as u64);
+    }
+}
 mod configuration;
 mod graph;
 mod lifecycle;
