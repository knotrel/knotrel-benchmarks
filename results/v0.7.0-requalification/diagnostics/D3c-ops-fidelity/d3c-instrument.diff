-                    None => state.apply(operation),
+                    None => {
+                        let t = std::time::Instant::now();
+                        let outcome = state.apply(operation);
+                        d3c_in_call += t.elapsed().as_nanos() as u64;
+                        d3c_ops += 1;
+                        outcome
+                    }
