 //! use the corresponding release tag when consulting a published version.
 
 mod api;
+/// D3c diagnostic counters (not a product API): nanoseconds and counts summed over every
+/// mutating batch since the last [`d3c::reset`].
+#[doc(hidden)]
+pub mod d3c {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    /// Counter names, in index order.
+    pub const NAMES: [&str; 4] = ["apply_ns", "in_call_ns", "operations", "batches"];
+    static C: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+    /// Zeroes every counter.
+    pub fn reset() {
+        for c in &C {
+            c.store(0, Ordering::Relaxed);
+        }
+    }
+    /// Current values, in [`NAMES`] order.
+    pub fn snapshot() -> [u64; 4] {
+        std::array::from_fn(|i| C[i].load(Ordering::Relaxed))
+    }
+    pub(crate) fn add(index: usize, value: u64) {
+        C[index].fetch_add(value, Ordering::Relaxed);
+    }
+}
 mod configuration;
 mod graph;
 mod lifecycle;
