+/// D2b diagnostic (not a product API): component pre-sizing policy, as factors of the
+/// registered node count (0 = off): catalog, engine ID map, adjacency header array.
+#[doc(hidden)]
+pub mod diag_d2b {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static F: [AtomicU32; 3] = [const { AtomicU32::new(0) }; 3];
+    /// Sets the factors (catalog, ids, headers).
+    pub fn set(catalog: f64, ids: f64, headers: f64) {
+        for (slot, v) in F.iter().zip([catalog, ids, headers]) {
+            slot.store((v * 1000.0).round() as u32, Ordering::Relaxed);
+        }
+    }
+    /// Target capacities for `n` registered nodes (catalog, ids, headers).
+    pub fn targets(n: usize) -> [usize; 3] {
+        std::array::from_fn(|i| (n as u64 * u64::from(F[i].load(Ordering::Relaxed)) / 1000) as usize)
+    }
+}
