+/// D1b diagnostic (not a product API): process-wide import sub-phase accumulators.
+#[doc(hidden)]
+pub mod diag_d1 {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::time::Instant;
+    /// Sub-phase names, by index.
+    pub const NAMES: [&str; 16] = [
+        "parse", "request_checks", "spec_conversion", "catalog_nodes", "edge_counting",
+        "incident_alloc", "fill", "sort_dedup", "finish_counts_shrink", "engine_ids_index",
+        "engine_adjacency_alloc", "engine_effective_pass", "engine_from_sorted", "plain_add_nodes",
+        "plain_links", "publish",
+    ];
+    static ACC: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+    /// Adds the time since `*t` to sub-phase `i` and restarts `*t`.
+    pub fn lap(i: usize, t: &mut Instant) {
+        let now = Instant::now();
+        ACC[i].fetch_add((now - *t).as_nanos() as u64, Ordering::Relaxed);
+        *t = now;
+    }
+    /// Resets all accumulators.
+    pub fn reset() {
+        for a in &ACC {
+            a.store(0, Ordering::Relaxed);
+        }
+    }
+    /// Reads all accumulators.
+    pub fn snapshot() -> [u64; 16] {
+        std::array::from_fn(|i| ACC[i].load(Ordering::Relaxed))
+    }
+}
