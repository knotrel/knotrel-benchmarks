+/// D3b diagnostic (not a product API): process-wide work counters.
+#[doc(hidden)]
+pub mod diag_d3b {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    /// Counter names, by index.
+    pub const NAMES: [&str; 10] = [
+        "engine_link", "engine_cut", "engine_shift_elems", "engine_new_vertex", "incident_scanned",
+        "neighbor_catalog_probes", "incident_shift_elems", "incident_binary_searches", "compactions",
+        "compaction_vertices",
+    ];
+    static C: [AtomicU64; 10] = [const { AtomicU64::new(0) }; 10];
+    /// Adds `v` to counter `i`.
+    #[inline]
+    pub fn add(i: usize, v: u64) {
+        C[i].fetch_add(v, Ordering::Relaxed);
+    }
+    /// Reads all counters.
+    pub fn snapshot() -> [u64; 10] {
+        std::array::from_fn(|i| C[i].load(Ordering::Relaxed))
+    }
+}
