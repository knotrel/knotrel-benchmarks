+/// D4c diagnostic (not a product behaviour): bit mask read once from `KNOTREL_D4C`
+/// (`ctl` 0, `nocount` 1, `noclock` 2, `nogauge` 4, `notrack` 8, `noall` 15).
+pub(crate) fn d4c() -> u8 {
+    static MASK: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *MASK.get_or_init(|| match std::env::var("KNOTREL_D4C").as_deref() {
+        Ok("ctl") | Err(_) => 0,
+        Ok("nocount") => 1,
+        Ok("noclock") => 2,
+        Ok("nogauge") => 4,
+        Ok("notrack") => 8,
+        Ok("noall") => 15,
+        Ok(other) => panic!("KNOTREL_D4C={other}"),
+    })
+}
