 fn main() -> ExitCode {
+    // D2c diagnostic: KNOTREL_D2C = T1 | T2 selects the catalog tombstone policy.
+    // Event log pre-allocated before any baseline, so it never enters net heap.
+    knotrel_core::diag_d2c::reserve(1 << 16);
+    match std::env::var("KNOTREL_D2C").as_deref() {
+        Ok("T1") => knotrel_core::diag_d2c::set_policy(1),
+        Ok("T2") => knotrel_core::diag_d2c::set_policy(2),
+        Ok(other) => panic!("KNOTREL_D2C={other}"),
+        Err(_) => {}
+    }
     let mut items = std::env::args().skip(1);
     let command = items.next().unwrap_or_default();
