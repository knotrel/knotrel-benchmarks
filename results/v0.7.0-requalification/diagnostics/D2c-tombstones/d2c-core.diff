     }
 }
+
+/// D2c diagnostic (not a product API): catalog tombstone policy and event timing.
+#[doc(hidden)]
+pub mod diag_d2c {
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicU8, Ordering};
+    /// 0 = frozen, 1 = T1 (rebuild instead of grow), 2 = T2 (T1 + rebuild after compaction).
+    static POLICY: AtomicU8 = AtomicU8::new(0);
+    static EVENTS: Mutex<Vec<(&'static str, u64, usize)>> = Mutex::new(Vec::new());
+    /// Sets the policy.
+    pub fn set_policy(policy: u8) {
+        POLICY.store(policy, Ordering::Relaxed);
+    }
+    /// Current policy.
+    pub fn policy() -> u8 {
+        POLICY.load(Ordering::Relaxed)
+    }
+    /// Records one event: kind, duration in ns, live catalog entries.
+    pub fn record(kind: &'static str, ns: u64, live: usize) {
+        EVENTS.lock().unwrap().push((kind, ns, live));
+    }
+    /// Pre-allocates room for `n` events, so recording allocates nothing.
+    pub fn reserve(n: usize) {
+        EVENTS.lock().unwrap().reserve(n);
+    }
+    /// Takes the recorded events.
+    pub fn take() -> Vec<(&'static str, u64, usize)> {
+        std::mem::take(&mut *EVENTS.lock().unwrap())
+    }
+}
