+/// D4b diagnostic (not a product API): runs `iterations` times the work `track_http` does
+/// per request outside `next.run` (route and method labels, one clock read pair, one
+/// counter increment and one histogram observation through `Family::get_or_create`) on
+/// families of the same types; returns total nanoseconds. The middleware's async frame
+/// and request extension lookup are not included.
+#[doc(hidden)]
+pub fn d4b_middleware_micro(iterations: u64) -> u64 {
+    let requests = Family::<RequestLabels, Counter>::default();
+    let durations: DurationFamily = Family::new_with_constructor(|| Histogram::new(DURATION_BUCKETS));
+    let start = Instant::now();
+    for _ in 0..iterations {
+        let path = std::hint::black_box("/v1/batch");
+        let route = crate::api::Route::ALL
+            .into_iter()
+            .map(crate::api::Route::as_str)
+            .find(|route| *route == path)
+            .unwrap_or("unmatched");
+        let method = method_label(std::hint::black_box(&Method::POST));
+        let t = Instant::now();
+        let elapsed = std::hint::black_box(t).elapsed().as_secs_f64();
+        requests
+            .get_or_create(&[("route", route), ("method", method), ("status_class", status_label(StatusCode::OK))])
+            .inc();
+        durations.get_or_create(&[("route", route)]).observe(elapsed);
+    }
+    start.elapsed().as_nanos() as u64
+}
