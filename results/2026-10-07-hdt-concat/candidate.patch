+    /// Remove the final token and return the remaining AVL tour and token.
+    /// Only the right spine changes. Deletion decreases subtree height by at
+    /// most one, so balancing each ancestor preserves AVL bounds in O(log V).
+    fn pop_last(&mut self, root: usize) -> (Option<usize>, usize) {
+        if let Some(right) = self.take_right(root) {
+            let (rest, pivot) = self.pop_last(right);
+            self.tokens[root].right = rest;
+            (Some(self.balance(root)), pivot)
+        } else {
+            let left = self.take_left(root);
+            self.pull(root);
+            (left, root)
+        }
+    }
