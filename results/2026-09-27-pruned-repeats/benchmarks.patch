+        assert!(output.status.success());
+        let report: Value = serde_json::from_slice(&output.stdout).unwrap();
+        fingerprints.push(report["trace_fingerprint_fnv1a64"].clone());
+        traces.push(std::fs::read(&path).unwrap());
